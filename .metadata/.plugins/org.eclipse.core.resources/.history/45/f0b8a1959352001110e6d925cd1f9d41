package com.chandru.demo.DAO;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Repository;

import com.chandru.demo.model.Student;

import jakarta.persistence.EntityManager;
import jakarta.transaction.Transactional;

@Repository
public class StudentDaoImpl implements StudentDAO {
	private EntityManager entitymanager;// This is core JPA (Java Persistence API) interface for database
										// operations.Hibernate's "brain" — it manages entities, tracks changes,
										// executes queries, and handles transactions. Think of it as the bridge between
										// your Java objects and the database.

	@Autowired // It will be used for dependency injection. Spring automatically finds and
				// injects required objects without you manually creating them with new.
	public StudentDaoImpl(EntityManager entitymanager) {
		super();
		this.entitymanager = entitymanager;
	}

	@Override
	@Transactional // 1. Spring starts a new database transaction (or joins an existing one)
					// 2. Hibernate flushes changes to the database
					// 3. If no exceptions occur, the transaction commits (changes become permanent)
					// 4. If any RuntimeException occurs, the transaction rolls back (changes are
					// undone)
	public void save(Student theStudent) {
		entitymanager.persist(theStudent);

	}

}
