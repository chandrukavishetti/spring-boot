package com.chandru.demo.model;

import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class EngineController {

	private Engine engine;
	private Engine myEngine;

	public EngineController(@Qualifier("hydrozenEngine") Engine engine, @Qualifier("hydrozenEngine") Engine myEngine) {
		System.out.println(" in constructor : " + getClass().getSimpleName());
		this.engine = engine;
		this.myEngine = myEngine;
	}

	@GetMapping("/check")
	public String check() {
		return "comparing bean engine engine==myEngine : " + (engine == myEngine);
	}

	@GetMapping("/enginetype")
	public String getEngineType() {
		return engine.getEngine();
	}
}
